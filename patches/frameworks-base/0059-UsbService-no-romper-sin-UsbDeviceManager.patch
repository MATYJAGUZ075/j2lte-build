From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MATYJAGUZ075 <155926881+MATYJAGUZ075@users.noreply.com>
Date: Sat, 19 Oct 2026 00:00:00 -0300
Subject: [PATCH] usb: no romper Ajustes cuando no hay UsbDeviceManager

El UsbService solo crea el UsbDeviceManager si existe /sys/class/android_usb,
que es la interfaz del driver de gadget del kernel (g_android). Cuando ese path
no existe, el manager queda null y varias llamadas lanzan
IllegalStateException con Preconditions.checkState().

La que mas se nota es getCurrentFunctions(), porque Ajustes la llama al abrir
la pantalla de preferencias USB y la app de Ajustes se cerraba:

  Caused by: java.lang.IllegalStateException
    at com.android.server.usb.UsbService.getCurrentFunctions(UsbService.java:628)
    at android.hardware.usb.IUsbManager$Stub.onTransact(IUsbManager.java:713)
    at android.hardware.usb.UsbManager.getCurrentFunctions(UsbManager.java:1056)
    at com.android.settings.connecteddevice.usb.UsbBackend.getCurrentFunctions(UsbBackend.java:87)
    at com.android.settings.connecteddevice.usb.UsbDetailsFunctionsController.<init>(UsbDetailsFunctionsController.java:71)
    at com.android.settings.connecteddevice.usb.UsbDetailsFragment.createControllerList(UsbDetailsFragment.java:95)

Medido en el telefono con este arbol:

  $ logcat -b crash -d | grep -A5 "FATAL EXCEPTION: main"
  FATAL EXCEPTION: main
  Process: com.android.settings, PID: 21328
  java.lang.RuntimeException: Unable to start activity
      ComponentInfo{com.android.settings/com.android.settings.SubSettings}:
      java.lang.IllegalStateException

Y el servidor:

  Caused by: android.os.RemoteException: Remote stack trace:
    at com.android.internal.util.Preconditions.checkState(Preconditions.java:215)
    at com.android.server.usb.UsbService.getCurrentFunctions(UsbService.java:628)

En vez de propagar la excepcion, se devuelve un valor neutro:

  - getCurrentFunctions() devuelve 0 (no hay funcion USB activa),
  - setCurrentFunctions() no hace nada,
  - getControlFd() devuelve null.

Con esto la pantalla de Ajustes se abre en vez de cerrar la app, y el
framework no se entera de que la gestion de funciones USB no esta disponible.

Nota: esto es una red de seguridad, no el arreglo de raiz. La causa de que
/sys/class/android_usb no exista es que en este kernel hay dos drivers de
gadget compitiendo por el UDC (g_ffs por CONFIG_USB_FUNCTIONFS y g_android
por CONFIG_USB_G_ANDROID) y gana el primero. Arreglando eso, /sys/class/android_usb
vuelve a existir, el UsbDeviceManager se crea con normalidad y estas tres
llamadas no necesitan el caso especial. El parche se deja igualmente porque
evita que un path ausente de USB cierre una app del sistema.

---
 services/usb/java/com/android/server/usb/UsbService.java | 27 +++++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)
diff --git a/services/usb/java/com/android/server/usb/UsbService.java b/services/usb/java/com/android/server/usb/UsbService.java
index 86f877f..182c039 100644
--- a/services/usb/java/com/android/server/usb/UsbService.java
+++ b/services/usb/java/com/android/server/usb/UsbService.java
@@ -347,6 +347,9 @@ public class UsbService extends IUsbManager.Stub {
     @Override
     public ParcelFileDescriptor getControlFd(long function) {
         mContext.enforceCallingOrSelfPermission(android.Manifest.permission.ACCESS_MTP, null);
+        if (mDeviceManager == null) {
+            return null;
+        }
         return mDeviceManager.getControlFd(function);
     }
 
@@ -608,7 +611,12 @@ public class UsbService extends IUsbManager.Stub {
     public void setCurrentFunctions(long functions) {
         mContext.enforceCallingOrSelfPermission(android.Manifest.permission.MANAGE_USB, null);
         Preconditions.checkArgument(UsbManager.areSettableFunctions(functions));
-        Preconditions.checkState(mDeviceManager != null);
+        if (mDeviceManager == null) {
+            // Sin UsbDeviceManager no hay gestion de funciones USB: el path
+            // /sys/class/android_usb no existe. Se ignora en vez de lanzar
+            // IllegalStateException y cerrar la app que llama.
+            return;
+        }
         mDeviceManager.setCurrentFunctions(functions);
     }
 
@@ -625,7 +633,22 @@ public class UsbService extends IUsbManager.Stub {
     @Override
     public long getCurrentFunctions() {
         mContext.enforceCallingOrSelfPermission(android.Manifest.permission.MANAGE_USB, null);
-        Preconditions.checkState(mDeviceManager != null);
+        if (mDeviceManager == null) {
+            // El UsbDeviceManager solo se crea si existe /sys/class/android_usb, que
+            // es la interfaz del driver de gadget del kernel (g_android). Si ese
+            // path no existe, el manager es null y esta llamada lanzaba
+            // IllegalStateException, con lo que Ajustes -> Preferencias USB
+            // cerraba la app de Ajustes al abrirla:
+            //
+            //   Caused by: java.lang.IllegalStateException
+            //     at com.android.server.usb.UsbService.getCurrentFunctions(UsbService.java:628)
+            //     at android.hardware.usb.IUsbManager$Stub.onTransact(IUsbManager.java:713)
+            //     at com.android.settings.connecteddevice.usb.UsbBackend.getCurrentFunctions(UsbBackend.java:87)
+            //     at com.android.settings.connecteddevice.usb.UsbDetailsFunctionsController.<init>(UsbDetailsFunctionsController.java:71)
+            //
+            // Se devuelve 0 (sin funcion USB activa) en vez de romper la llamada.
+            return 0;
+        }
         return mDeviceManager.getCurrentFunctions();
     }
 
