+// Soporte de camara HALv1.
+//
+// El provider HIDL 2.4-legacy de A13 ya implementa
+// getCameraDeviceInterface_V1_x, asi que la interfaz V1_0 se pide al provider
+// igual que la V3_2. Lo que A13 elimino fue el lado de la plataforma (el
+// DeviceInfo1 del CameraProviderManager y el shim camera2.legacy), que es lo
+// que se restaura aqui.
+HidlProviderInfo::HidlDeviceInfo1::HidlDeviceInfo1(
+        const std::string& name,
+        const metadata_vendor_id_t tagId,
+        const std::string &id, uint16_t minorVersion,
+        const CameraResourceCost& resourceCost,
+        sp<CameraProviderManager::ProviderInfo> parentProvider,
+        const std::vector<std::string>& publicCameraIds,
+        sp<hardware::camera::device::V1_0::ICameraDevice> interface) :
+        DeviceInfo1(name, tagId, id, minorVersion, resourceCost, parentProvider, publicCameraIds,
+                    interface) {
+    // Los parametros por defecto del HAL1 dicen si hay flash, y de ahi sale
+    // tambien la info de la camara que se cachea.
+    Status status;
+    hardware::Return<void> ret;
+    ret = interface->getParameters([this](const hardware::hidl_string& parms) {
+                mDefaultParameters.unflatten(String8(parms.c_str()));
+            });
+    if (!ret.isOk()) {
+        ALOGE("%s: Transaction error reading camera device %s params: %s",
+                __FUNCTION__, id.c_str(), ret.description().c_str());
+        return;
+    }
+    const char *flashMode =
+            mDefaultParameters.get(CameraParameters::KEY_SUPPORTED_FLASH_MODES);
+    if (flashMode && strstr(flashMode, CameraParameters::FLASH_MODE_TORCH)) {
+        mHasFlashUnit = true;
+    }
+
+    status_t res = cacheCameraInfo(interface);
+    if (res != OK) {
+        ALOGE("%s: Could not cache CameraInfo", __FUNCTION__);
+        return;
+    }
+
+    if (!kEnableLazyHal) {
+        // Save HAL reference indefinitely
+        mSavedInterface = interface;
+    }
+}
+
+status_t HidlProviderInfo::HidlDeviceInfo1::cacheCameraInfo(
+        sp<HidlProviderInfo::HidlDeviceInfo1::InterfaceT> interface) {
+    // La interfaz HIDL V1_0 de A13 expone getCameraInfo(), que devuelve
+    // directamente el facing y la orientacion del sensor.
+    Status status = Status::OK;
+    hardware::camera::device::V1_0::CameraInfo info;
+    hardware::Return<void> ret;
+    ret = interface->getCameraInfo([&status, &info](
+            Status s, hardware::camera::device::V1_0::CameraInfo i) {
+                status = s;
+                info = i;
+            });
+    if (!ret.isOk()) {
+        ALOGE("%s: Transaction error getting camera info: %s",
+                __FUNCTION__, ret.description().c_str());
+        return DEAD_OBJECT;
+    }
+    if (status != Status::OK) {
+        ALOGE("%s: Unable to obtain camera info: %s",
+                __FUNCTION__, mapToStatusT(status));
+        return DEAD_OBJECT;
+    }
+
+    // El campo facing del tipo CameraInfo de la interfaz V1_0 es un uint32_t
+    // (el enum CameraFacing es de otro tipo), asi que hay que castearlo.
+    hardware::camera::device::V1_0::CameraFacing facing =
+            static_cast<hardware::camera::device::V1_0::CameraFacing>(info.facing);
+    mInfo.facing = (facing == hardware::camera::device::V1_0::CameraFacing::FRONT)
+            ? hardware::CAMERA_FACING_FRONT
+            : hardware::CAMERA_FACING_BACK;
+    mInfo.orientation = info.orientation;
+
+    return OK;
+}
