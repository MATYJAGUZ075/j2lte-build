<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- j2lte-slim — reduce el árbol fuente jugando ÚNICAMENTE sobre prebuilts
       que el build LINUX x86_64 de lineage_j2lte-userdebug NO necesita.

       REGLAS RESPETADAS:
       - Nada de poda post-sync (todo se evita ya en repo sync).
       - NO toca .repo/project-objects ni .repo/projects.
       - NO incluye abi-dumps (siguiente escalón si aún no alcanza).
       - NO incluye test/* ni cts ni platform_testing (riesgo documentado:
         revert ea0c373 — art necesita csuite_test en Kati).
       - NO incluye gcc/linux-x86/host/* (== LinuxGccRoot, toolchain host de
         clang via x86_linux_host.go:135 — rompería el build).
       - NO incluye prebuilts/misc (== YASM, config.mk:574 — rompería).
       - NO incluye tools/sdk/runtime/r8 (referencias en core build, riesgo).

       Cada entrada clasificada y verificada contra referencias reales en
       build/soong y build/make del árbol LOS20 (ver comentarios). -->

  <!-- ===================== CAPA 1: 100% SEGUROS ===================== -->

  <!-- Emulador: solo se usa en desarrollo/arranque de emulador.
       Ref build: únicamente build/make/envsetup.sh (uso dev). NUNCA para
       el build de un device. ~1.6G -->
  <remove-project name="platform/prebuilts/android-emulator" />

  <!-- Clang host darwin: seleccionado SOLO cuando HOST_OS=darwin
       (combo/select.mk:24, Makefile:6916). Host Linux = no se toca. ~2G -->
  <remove-project name="platform/prebuilts/clang/host/darwin-x86" />

  <!-- Bazel darwin: solo host mac. ~33M -->
  <remove-project name="platform/prebuilts/bazel/darwin-x86_64" />

  <!-- Go darwin: solo host mac. ~612M -->
  <remove-project name="platform/prebuilts/go/darwin-x86" />

  <!-- Cliente RBE (remoteexecution): usa 'remoteexec' gated por UseRBE()/
       UseRemoteBuild() en config.go:985-1001; NO se setea productVariables
       en nuestro build (sin refs en build/make/core). Solo se instancia si
       se invoca con remote-build. ~9.1G -->
  <remove-project name="platform/prebuilts/remoteexecution-client" />

  <!-- ===================== CAPA 2: VERIFICADOS (dev/tooling) ========== -->

  <!-- Gradle plugin: solo para desarrollo de proyectos gradle Android.
       Sin refs en build/make ni build/soong. ~3.8G (roto, no quitar) -->

  <!-- Maven repos: repositorios de artefactos Maven (3rd-party jars).
       Sin refs reales en core build (se descargan de host maven si hiciera
       falta). (bumptech roto, no borrar) ~656M -->
  <remove-project name="platform/prebuilts/maven_repo/android" />

  <!-- asuite: Android Studio tooling, solo envsetup.sh. ~65M -->
  <remove-project name="platform/prebuilts/asuite" />

  <!-- devtools: solo envsetup.sh. ~49M -->
  <remove-project name="platform/prebuilts/devtools" />

  <!-- cmdline-tools: sin refs en core build. (descartado, da error) ~111M -->

  <!-- ktlint: linter Kotlin, sin refs en core build. ~60M -->
  <remove-project name="platform/prebuilts/ktlint" />

  <!-- checkstyle: linter Java, sin refs en core build. ~6M -->
  <remove-project name="platform/prebuilts/checkstyle" />

  <!-- checkcolor: sin refs en core build. ~16K -->
  <remove-project name="platform/prebuilts/checkcolor" />

  <!-- ===================== CAPA 3: KERNEL PREBUILTS GKI (j2lte usa 3.10 de fuente) ========== -->

  <!-- Kernels GKI prebuilt: j2lte compila kernel 3.10 desde
       kernel/samsung/exynos3475 (TARGET_KERNEL_SOURCE). Los prebuilts
       5.4/5.10/5.15 + common-modules/virtual-device solo los consumen
       productos emulator/goldfish/cuttlefish/gki (device/generic/*,
       device/google/cuttlefish/*, emulator_arm64). Cero refs en
       device/samsung, vendor/*, kernel/samsung, hardware/*, system/,
       frameworks/, packages/ y build/soong; sus Android.bp definen solo
       filegroups sin consumidores externos. Se excluyen vía manifest
       (los arch/* contienen .git, no aptos para rm -rf post-sync).
       ~240M -->
  <remove-project name="kernel/prebuilts/5.4/arm64" />
  <remove-project name="kernel/prebuilts/5.4/x86-64" />

  <!-- Idem 5.10. ~280M -->
  <remove-project name="kernel/prebuilts/5.10/arm64" />
  <remove-project name="kernel/prebuilts/5.10/x86-64" />

  <!-- Idem 5.15. ~273M -->
  <remove-project name="kernel/prebuilts/5.15/arm64" />
  <remove-project name="kernel/prebuilts/5.15/x86-64" />

  <!-- Módulos GKI common-modules/virtual-device (solo dispositivo virtual).
       ~370M -->
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/4.19/arm64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/4.19/x86-64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/5.4/arm64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/5.4/x86-64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/5.10/arm64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/5.10/x86-64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/5.15/arm64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/5.15/x86-64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/mainline/arm64" />
  <remove-project name="kernel/prebuilts/common-modules/virtual-device/mainline/x86-64" />

  <!-- Prebuilts restantes 4.19/mainline top-level (mismo caso GKI que CAPA 3:
       solo emulator/goldfish/cuttlefish; j2lte usa kernel 3.10 de fuente).
       4.19 top-level solo tiene arm64 en el manifest. ~65M + ~170M -->
  <remove-project name="kernel/prebuilts/4.19/arm64" />
  <remove-project name="kernel/prebuilts/mainline/arm64" />
  <remove-project name="kernel/prebuilts/mainline/x86-64" />

  <!-- ===================== CAPA 4: QCOM/PIXEL AJENOS (bloque completo) ========== -->
  <!-- hardware/qcom-caf/* + hardware/qcom/* + kernel/google/gs201/*:
       j2lte/Exynos3475 no los consume (cero refs en su cierre).
       qcom-caf/common declara los linkfiles os_pickup_*, por eso el bloque
       va COMPLETO: sin common no hay guards, sin hojas no hay dest huérfanos.
       device/google/cuttlefish* RESTAURADO (run #118: microdroid/payload
       necesita libcdisk_spec/libcuttlefish_fs/libcuttlefish_utils/
       libimage_aggregator -> undefined module sin Cuttlefish).
       device/google/atv+contexthub+gs-common+vrservices y device/qcom/*
       NO se tocan (fuera del alcance auditado). -->

  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <remove-project name="LineageOS/android_hardware_qcom_audio" />
  <remove-project name="LineageOS/android_hardware_qcom_audio-ar" />
