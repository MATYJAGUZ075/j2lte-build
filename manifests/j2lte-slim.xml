  <!-- ===================== CAPA 5: GPU/TEST AJENOS (swiftshader/angle) ========== -->
  <!-- SwiftShader y ANGLE son proyectos Git completos (post-sync rm imposible:
       el guard .git abortaría). Sin consumidores en frameworks/packages/
       system/hardware/vendor/build/device/kernel/art/cts/test/tools ni en el
       producto j2lte; sin dependencias cruzadas entre sí. Se excluyen vía
       manifest. DEQP RESTAURADO (run #124: deqp-deps/amber necesita
       deqp_and_deps_defaults -> undefined module sin external/deqp).
       NO volver a excluir sin podar también a su consumidor. -->

  <remove-project name="platform/external/swiftshader" />
  <remove-project name="platform/external/angle" />

  <!-- ===================== CAPA 6: EMULADOR/MEDIA AJENOS ========== -->
  <!-- Proyectos Git completos con cero consumidores en frameworks/packages/
       system/hardware/vendor/build/device/kernel/art/cts/test/tools/external
       ni en el producto j2lte (verificado incl. alcance external/ y cts/).
       Se excluyen vía manifest. Si bootstrap falla con undefined module,
       revertir el correspondiente. -->

  <!-- platform/external/jackson-core RESTAURADO (run #125:
       external/jackson-databind necesita jackson-core -> undefined module
       sin external/jackson-core). NO volver a excluir. -->
