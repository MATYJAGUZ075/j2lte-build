  <!-- j2lte-slim — reduce el árbol fuente jugando ÚNICAMENTE sobre prebuilts
       que el build LINUX x86_64 de lineage_j2lte-userdebug NO necesita.

       REGLAS RESPETADAS:
       - Nada de poda post-sync (todo se evita ya en repo sync).
       - NO toca .repo/project-objects ni .repo/projects.
       - NO incluye abi-dumps (siguiente escalón si aún no alcanza).
       - NO incluye test/* ni cts ni platform_testing (riesgo documentado:
         revert ea0c373 — art necesita csuite_test en Kati).
       - NO incluye gcc/linux-x86/host/* (== LinuxGccRoot, toolchain host de
         clang via x86_linux_host.go:135 — rompería el build).
       - NO incluye prebuilts/misc (== YASM, config.mk:574 — rompería).
       - NO incluye tools/sdk/runtime/r8 (referencias en core build, riesgo).

       Cada entrada clasificada y verificada contra referencias reales en
       build/soong y build/make del árbol LOS20 (ver comentarios). -->

  <!-- ===================== CAPA 1: 100% SEGUROS ===================== -->

  <!-- Emulador: solo se usa en desarrollo/arranque de emulador.
       Ref build: únicamente build/make/envsetup.sh (uso dev). NUNCA para
       el build de un device. ~1.6G -->
  <remove-project name="platform/prebuilts/android-emulator" />

  <!-- Clang host darwin: seleccionado SOLO cuando HOST_OS=darwin
       (combo/select.mk:24, Makefile:6916). Host Linux = no se toca. ~2G -->
  <remove-project name="platform/prebuilts/clang/host/darwin-x86" />

  <!-- Bazel darwin: solo host mac. ~33M -->
  <remove-project name="platform/prebuilts/bazel/darwin-x86_64" />

  <!-- Go darwin: solo host mac. ~612M -->
  <remove-project name="platform/prebuilts/go/darwin-x86" />

  <!-- Cliente RBE (remoteexecution): usa 'remoteexec' gated por UseRBE()/
       UseRemoteBuild() en config.go:985-1001; NO se setea productVariables
       en nuestro build (sin refs en build/make/core). Solo se instancia si
       se invoca con remote-build. ~9.1G -->
  <remove-project name="platform/prebuilts/remoteexecution-client" />

  <!-- ===================== CAPA 2: VERIFICADOS (dev/tooling) ========== -->

  <!-- Gradle plugin: solo para desarrollo de proyectos gradle Android.
       Sin refs en build/make ni build/soong. ~3.8G (roto, no quitar) -->

