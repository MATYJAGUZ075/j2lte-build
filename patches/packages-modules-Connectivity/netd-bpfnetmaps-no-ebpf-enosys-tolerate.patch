 import static android.system.OsConstants.EOPNOTSUPP;
 
 import android.net.INetd;
@@ -40,6 +41,7 @@ public class BpfNetMaps {
     // Use legacy netd for releases before T.
     private static final boolean USE_NETD = !SdkLevel.isAtLeastT();
     private static boolean sInitialized = false;
+    private static boolean sLoggedMissingEbpf = false;
 
     /**
      * Initializes the class if it is not already initialized. This method will open maps but not
@@ -68,6 +70,17 @@ public class BpfNetMaps {
 
     private void maybeThrow(final int err, final String msg) {
         if (err != 0) {
+            if (Math.abs(err) == ENOSYS) {
+                // El kernel no tiene soporte de eBPF (bpf() llego en Linux 4.x).
+                // Las funciones que dependen de eBPF no estan disponibles en
+                // este hardware, asi que no es un error: solo se avisa una vez
+                // y se sigue como si la operacion hubiera sido un no-op.
+                if (!sLoggedMissingEbpf) {
+                    sLoggedMissingEbpf = true;
+                    Log.w(TAG, msg + ": eBPF is not supported by this kernel, ignoring");
+                }
+                return;
+            }
             throw new ServiceSpecificException(err, msg + ": " + Os.strerror(err));
         }
     }
@@ -150,7 +163,17 @@ public class BpfNetMaps {
             final int[] uids) {
         final int err = native_replaceUidChain(chainName, isAllowlist, uids);
         if (err != 0) {
-            Log.e(TAG, "replaceUidChain failed: " + Os.strerror(-err));
+            if (Math.abs(err) == ENOSYS) {
+                // El kernel no soporta eBPF: la cadena de firewall por UID no
+                // se puede aplicar, pero no es un error del servicio.
+                if (!sLoggedMissingEbpf) {
+                    sLoggedMissingEbpf = true;
+                    Log.w(TAG, "replaceUidChain failed: eBPF is not supported by this kernel, "
+                            + "ignoring");
+                }
+            } else {
+                Log.e(TAG, "replaceUidChain failed: " + Os.strerror(-err));
+            }
         }
         return -err;
     }
