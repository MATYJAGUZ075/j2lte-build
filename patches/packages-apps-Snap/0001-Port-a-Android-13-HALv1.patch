diff --git a/Android.bp b/Android.bp
new file mode 100644
index 0000000..37039bb
--- /dev/null
+++ b/Android.bp
@@ -0,0 +1,29 @@
+// Android.bp para LineageOS Snap (cm-12.1), app de camara camera1 real
+// usada por Lineage en dispositivos con HAL v1. Portado a Android 13.
+//
+// El Android.mk original se elimina en este mismo parche: no pueden coexistir
+// Android.mk y Android.bp para el mismo modulo (modulo duplicado).
+
+android_app {
+    name: "Snap",
+    srcs: [
+        "src/**/*.java",
+        "src_pd/**/*.java",
+        "src_pd_gcam/**/*.java",
+    ],
+    resource_dirs: ["res"],
+    libs: [
+        "xmp_toolkit",
+    ],
+    jni_libs: [
+        "libjni_snapmosaic",
+        "libjni_snaptinyplanet",
+    ],
+    certificate: "platform",
+    platform_apis: true,
+    version_name: "2.0.002",
+    version_code: "20002130",
+    optimize: {
+        proguard_flags_file: "proguard.flags",
+    },
+}
