+sp<hardware::camera::device::V1_0::ICameraDevice>
+HidlProviderInfo::HidlDeviceInfo1::startDeviceInterface() {
+    Mutex::Autolock l(mDeviceAvailableLock);
+    sp<hardware::camera::device::V1_0::ICameraDevice> device;
+    ATRACE_CALL();
+    if (mSavedInterface == nullptr) {
+        sp<HidlProviderInfo> parentProvider =
+                static_cast<HidlProviderInfo *>(mParentProvider.promote().get());
+        if (parentProvider == nullptr) {
+            return nullptr;
+        }
+        const sp<hardware::camera::provider::V2_4::ICameraProvider> provider =
+                parentProvider->startProviderInterface();
+        if (provider == nullptr) {
+            return nullptr;
+        }
+        Status status;
+        hardware::Return<void> ret;
+        ret = provider->getCameraDeviceInterface_V1_x(mName,
+                [&status, &device](Status s,
+                        sp<hardware::camera::device::V1_0::ICameraDevice> interface) {
+                    status = s;
+                    device = interface;
+                });
+        if (!ret.isOk()) {
+            ALOGE("%s: Transaction error trying to obtain interface for camera device %s: %s",
+                    __FUNCTION__, mName.c_str(), ret.description().c_str());
+            return nullptr;
+        }
+        if (status != Status::OK) {
+            ALOGE("%s: Unable to obtain interface for camera device %s: %s", __FUNCTION__,
+                    mName.c_str(), mapToStatusT(status));
+            return nullptr;
+        }
+        mSavedInterface = device;
+    } else {
+        device = mSavedInterface;
+    }
+    return device;
+}
