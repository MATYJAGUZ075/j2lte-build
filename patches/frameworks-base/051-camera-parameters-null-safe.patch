+            // lugar de null: los consumidores iteran sobre la lista y con null
+            // reventaban con NullPointerException.
+            if (str == null) return new ArrayList<String>();
 
             TextUtils.StringSplitter splitter = new TextUtils.SimpleStringSplitter(',');
             splitter.setString(str);
@@ -4666,7 +4691,7 @@ public class Camera {
         // Splits a comma delimited string to an ArrayList of Integer.
         // Return null if the passing string is null or the size is 0.
         private ArrayList<Integer> splitInt(String str) {
-            if (str == null) return null;
+            if (str == null) return new ArrayList<Integer>();
 
             TextUtils.StringSplitter splitter = new TextUtils.SimpleStringSplitter(',');
             splitter.setString(str);
@@ -4674,7 +4699,6 @@ public class Camera {
             for (String s : splitter) {
                 substrings.add(Integer.parseInt(s));
             }
-            if (substrings.size() == 0) return null;
             return substrings;
         }
 
@@ -4704,8 +4728,12 @@ public class Camera {
         // Returns the value of a float parameter.
         private float getFloat(String key, float defaultValue) {
             try {
-                return Float.parseFloat(mMap.get(key));
-            } catch (NumberFormatException ex) {
+                String value = mMap.get(key);
+                if (value == null) {
+                    return defaultValue;
+                }
+                return Float.parseFloat(value);
+            } catch (NumberFormatException | NullPointerException ex) {
                 return defaultValue;
             }
         }
@@ -4722,7 +4750,7 @@ public class Camera {
