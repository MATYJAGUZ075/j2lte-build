  */
 
 #define LOG_TAG "TrafficController"
+#include <errno.h>
 #include <inttypes.h>
 #include <linux/if_ether.h>
 #include <linux/in.h>
@@ -483,8 +484,15 @@ int TrafficController::toggleUidOwnerMap(ChildChain chain, bool enable) {
     uint32_t key = UID_RULES_CONFIGURATION_KEY;
     auto oldConfigure = mConfigurationMap.readValue(key);
     if (!oldConfigure.ok()) {
-        ALOGE("Cannot read the old configuration from map: %s",
-              oldConfigure.error().message().c_str());
+        // El kernel 3.10 de este dispositivo no tiene eBPF, asi que el mapa
