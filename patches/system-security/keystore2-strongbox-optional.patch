+++ b/keystore2/src/maintenance.rs
@@ -183,20 +183,45 @@ impl Maintenance {
             (SecurityLevel::STRONGBOX, "STRONGBOX"),
         ];
         sec_levels.iter().fold(Ok(()), move |result, (sec_level, sec_level_string)| {
-            let curr_result = Maintenance::call_with_watchdog(*sec_level, name, &op);
-            match curr_result {
-                Ok(()) => log::info!(
-                    "Call to {} succeeded for security level {}.",
-                    name,
-                    &sec_level_string
-                ),
-                Err(ref e) => log::error!(
-                    "Call to {} failed for security level {}: {}.",
-                    name,
-                    &sec_level_string,
-                    e
-                ),
-            }
+            let curr_result = match Maintenance::call_with_watchdog(*sec_level, name, &op) {
+                Ok(()) => {
+                    log::info!(
+                        "Call to {} succeeded for security level {}.",
+                        name,
+                        &sec_level_string
+                    );
+                    Ok(())
+                }
+                Err(e) => {
+                    // Un nivel de seguridad sin dispositivo KeyMint no es un
+                    // fallo del servicio: STRONGBOX es opcional y no todos los
+                    // SoC lo implementan. Cuando el hardware no lo tiene, la
+                    // llamada no puede hacerse y no hay nada que notificar al
+                    // KeyMint de ese nivel, asi que se registra como info y se
+                    // sigue. El fallo de un nivel que si deberia existir
+                    // (TRUSTED_ENVIRONMENT) se sigue propagando, y tambien
+                    // cualquier fallo de la operacion en si (no el de obtener
+                    // el dispositivo).
+                    let no_keymint_device =
+                        e.to_string().contains("getting keymint device");
+                    if no_keymint_device && *sec_level == SecurityLevel::STRONGBOX {
+                        log::info!(
+                            "No KeyMint device for security level {}, skipping {}.",
+                            &sec_level_string,
+                            name
+                        );
+                        Ok(())
+                    } else {
+                        log::error!(
+                            "Call to {} failed for security level {}: {}.",
+                            name,
+                            &sec_level_string,
+                            e
+                        );
+                        Err(e)
+                    }
+                }
+            };
             result.and(curr_result)
         })
     }
