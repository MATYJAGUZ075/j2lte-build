diff --git a/sepolicy/vendor/hal_graphics_allocator_default.te b/sepolicy/vendor/hal_graphics_allocator_default.te
--- a/sepolicy/vendor/hal_graphics_allocator_default.te
+++ b/sepolicy/vendor/hal_graphics_allocator_default.te
@@ -5,3 +5,8 @@ allow hal_graphics_allocator_default sysfs_graphics:file rw_file_perms;
 # uevent socket
 allow hal_graphics_allocator_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
+
+# FIX-069: hal_graphics_allocator_default necesita leer default_prop
+# (persist.* properties) para inicializar el HAL de gráficos.
+# Sin esto la cámara frontal y Bluetooth no funcionan.
+allow hal_graphics_allocator_default default_prop:file r_file_perms;
+
diff --git a/sepolicy/vendor/hal_memtrack_default.te b/sepolicy/vendor/hal_memtrack_default.te
--- a/sepolicy/vendor/hal_memtrack_default.te
+++ b/sepolicy/vendor/hal_memtrack_default.te
@@ -3,3 +3,8 @@ allow hal_memtrack_default debugfs_mali:dir r_dir_perms;
 allow hal_memtrack_default debugfs_mali:file r_file_perms;
+
+# FIX-069: hal_memtrack_default necesita leer debugfs:s0
+# para inicializar el tracking de memoria de GPU.
+allow hal_memtrack_default debugfs:s0 file r_file_perms;
+
diff --git a/sepolicy/vendor/platform_app.te b/sepolicy/vendor/platform_app.te
--- a/sepolicy/vendor/platform_app.te
+++ b/sepolicy/vendor/platform_app.te
@@ -1,3 +1,8 @@
+# FIX-069: platform_app necesita leer mediaserver_exec:s0
+# para que trigger_perfett y otras apps del sistema puedan acceder
+# a servicios de medios sin denegaciones de sepolicy.
+allow platform_app mediaserver_exec:s0 file r_file_perms;
+
