+    // abierto, y de ellos sale la info de camara y la presencia de flash.
+    hardware::Return<Status> openRet = interface->open(nullptr);
+    if (!openRet.isOk()) {
+        ALOGE("%s: Transaction error opening camera device %s: %s",
+                __FUNCTION__, id.c_str(), openRet.description().c_str());
+        return;
+    }
+    if (openRet != Status::OK) {
+        ALOGE("%s: Unable to open camera device %s: %s", __FUNCTION__,
+                id.c_str(), statusToString(openRet));
+        return;
+    }
+
+    Status status = Status::OK;
+    hardware::Return<void> ret;
+    ret = interface->getParameters([this](const hardware::hidl_string& parms) {
+                mDefaultParameters.unflatten(String8(parms.c_str()));
+            });
+    if (!ret.isOk()) {
+        ALOGE("%s: Transaction error reading camera device %s params: %s",
+                __FUNCTION__, id.c_str(), ret.description().c_str());
+    } else {
+        const char *flashMode =
+                mDefaultParameters.get(CameraParameters::KEY_SUPPORTED_FLASH_MODES);
+        if (flashMode && strstr(flashMode, CameraParameters::FLASH_MODE_TORCH)) {
+            mHasFlashUnit = true;
+        }
+    }
+
+    hardware::camera::device::V1_0::CameraInfo cInfo;
+    ret = interface->getCameraInfo([&status, &cInfo](
+            Status s, hardware::camera::device::V1_0::CameraInfo info) {
+                status = s;
+                cInfo = info;
+            });
+    if (!ret.isOk()) {
+        ALOGE("%s: Transaction error reading camera info from device %s: %s",
+                __FUNCTION__, id.c_str(), ret.description().c_str());
+    } else if (status != Status::OK) {
+        ALOGE("%s: Unable to read camera info from device %s: %s", __FUNCTION__,
+                id.c_str(), statusToString(status));
+    } else {
+        switch (cInfo.facing) {
+            case hardware::camera::device::V1_0::CameraFacing::BACK:
+                mInfo.facing = hardware::CAMERA_FACING_BACK;
+                break;
+            case hardware::camera::device::V1_0::CameraFacing::EXTERNAL:
+                // Map external to front for the legacy API.
+            case hardware::camera::device::V1_0::CameraFacing::FRONT:
+                mInfo.facing = hardware::CAMERA_FACING_FRONT;
+                break;
+            default:
