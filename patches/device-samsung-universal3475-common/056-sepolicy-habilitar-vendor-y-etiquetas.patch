diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 042c006..40440e8 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -211,7 +211,10 @@ TARGET_RECOVERY_FSTAB := $(LOCAL_PATH)/ramdisk/etc/fstab.universal3475
 # Estructura LOS20: policies del device en sepolicy/vendor.
 # TODO(fase 3+): nuncaallows de plataforma 33 sin resolver — durante el porte
 # se permite ignorarlos (mismo enfoque que Exynos7420) hasta endurecer.
-BOARD_VENDOR_SEPOLICY_DIRS += $(LOCAL_PATH)/sepolicy/vendor
+# FIX-056: en contexto BoardConfig $(LOCAL_PATH) es build/make/core, por lo que
+# la ruta quedaba vacia y A13 la descartaba en silencio (wildcard). Usar ruta
+# absoluta desde la raiz del arbol.
+BOARD_VENDOR_SEPOLICY_DIRS += device/samsung/universal3475-common/sepolicy/vendor
 SELINUX_IGNORE_NEVERALLOWS := true
 
 # Soong namespaces
diff --git a/sepolicy/vendor/file.te b/sepolicy/vendor/file.te
index 08b2666..bff15a0 100644
--- a/sepolicy/vendor/file.te
+++ b/sepolicy/vendor/file.te
@@ -43,11 +43,13 @@ type sysfs_wifi, fs_type, sysfs_type, mlstrustedobject;
 type sysfs_usb_supply, sysfs_type, fs_type, mlstrustedobject;
 type sysfs_mmc, sysfs_type, fs_type, mlstrustedobject;
 type sysfs_graphics, sysfs_type, fs_type, mlstrustedobject;
-type sysfs_ion, sysfs_type, fs_type, mlstrustedobject;
 type sysfs_block, sysfs_type, fs_type, mlstrustedobject;
 type sysfs_jack, sysfs_type, fs_type, mlstrustedobject;
 type sysfs_v4l, sysfs_type, fs_type, mlstrustedobject;
 type sysfs_sswap, sysfs_type, fs_type, mlstrustedobject;
 
+# debugfs de Mali (memtrack)
+type debugfs_mali, fs_type, debugfs_type;
+
 ### data types
 type display_vendor_data_file, file_type, data_file_type;
