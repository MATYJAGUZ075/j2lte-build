diff --git a/ramdisk/etc/init.universal3475.usb.rc b/ramdisk/etc/init.universal3475.usb.rc
index 12c0d29..f8a4f6f 100644
--- a/ramdisk/etc/init.universal3475.usb.rc
+++ b/ramdisk/etc/init.universal3475.usb.rc
@@ -25,6 +25,14 @@ on boot
     write /sys/class/android_usb/android0/iSerial ${ro.serialno}
     write /sys/class/android_usb/f_mass_storage/inquiry_string "Samsung"
     setprop sys.usb.ffs.aio_compat 1
+    setprop sys.usb.config mtp,adb
+
+# El USB HAL de Samsung solo aplica el perfil "adb" (no conoce el modo MTP
+# clasico de android_usb). Forzamos MTP+ADB por la interfaz clasica del
+# gadget, que si soporta f_mtp, y asi el MediaProvider puede montar el
+# volumen emulated y servir MTP.
+on property:sys.boot_completed=1
+    setprop sys.usb.config mtp,adb
 
 on fs
     mkdir /dev/usb-ffs 0770 shell shell
