+ */
+
+package com.android.settings.j2lte;
+
+import android.app.ActivityManager;
+import android.content.Context;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+
+import java.io.File;
+import java.io.FileReader;
+import java.io.IOException;
+import java.io.LineNumberReader;
+
+/**
+ * Informacion de memoria: RAM total, RAM disponible y tamano del zram.
+ *
+ * Es solo lectura: no cambia nada.
+ */
+public class MemoryInfoController extends BasePreferenceController
+        implements PreferenceControllerMixin {
+
+    private static final String ZRAM_DISKSIZE = "/sys/block/zram0/disksize";
+    private static final long MB = 1024L * 1024L;
+
+    public MemoryInfoController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final ActivityManager am = mContext.getSystemService(ActivityManager.class);
+        long totalMb = 0;
+        long availMb = 0;
+        boolean lowMemory = false;
+        if (am != null) {
+            final ActivityManager.MemoryInfo info = new ActivityManager.MemoryInfo();
+            am.getMemoryInfo(info);
+            totalMb = info.totalMem / MB;
+            availMb = info.availMem / MB;
+            lowMemory = info.lowMemory;
+        }
+        final String zram = zramSize();
+        preference.setSummary(mContext.getString(R.string.j2lte_memory_info_summary,
+                totalMb, availMb, zram, lowMemory
+                        ? mContext.getString(R.string.j2lte_memory_pressure_high)
+                        : mContext.getString(R.string.j2lte_memory_pressure_normal)));
+    }
+
+    /** Tamano del zram en MB, o null si el kernel no lo tiene o no se puede leer. */
+    private String zramSize() {
+        final File file = new File(ZRAM_DISKSIZE);
+        if (!file.exists()) {
+            return mContext.getString(R.string.j2lte_not_available);
+        }
+        try (LineNumberReader reader = new LineNumberReader(new FileReader(file))) {
+            final long bytes = Long.parseLong(reader.readLine().trim());
+            return (bytes / MB) + " MB";
+        } catch (IOException | NumberFormatException | NullPointerException e) {
+            return mContext.getString(R.string.j2lte_not_available);
+        }
+    }
+}
