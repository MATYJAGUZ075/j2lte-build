+        if (abs(oldConfigure.error().code()) == ENOSYS) {
+            ALOGI("eBPF is not supported by this kernel, cannot toggle the UID owner map");
+        } else {
+            ALOGE("Cannot read the old configuration from map: %s",
+                  oldConfigure.error().message().c_str());
+        }
         return -oldConfigure.error().code();
     }
     Status res;
@@ -533,8 +541,15 @@ Status TrafficController::swapActiveStatsMap() {
     uint32_t key = CURRENT_STATS_MAP_CONFIGURATION_KEY;
     auto oldConfigure = mConfigurationMap.readValue(key);
     if (!oldConfigure.ok()) {
-        ALOGE("Cannot read the old configuration from map: %s",
-              oldConfigure.error().message().c_str());
+        // El kernel 3.10 de este dispositivo no tiene eBPF, asi que el mapa
+        // no existe y leerlo falla con ENOSYS. Eso no es un error del
+        // servicio: las estadisticas por UID simplemente no estan disponibles.
+        if (abs(oldConfigure.error().code()) == ENOSYS) {
+            ALOGI("eBPF is not supported by this kernel, cannot swap the active stats map");
+        } else {
+            ALOGE("Cannot read the old configuration from map: %s",
