 #include <vector>
 
 
@@ -37,12 +39,24 @@ using UidOwnerMatchType::HAPPY_BOX_MATCH;
 
 static android::net::TrafficController mTc;
 
+// El kernel de este dispositivo (3.10) no tiene soporte de eBPF, asi que
+// todas las operaciones que dependen de bpf() fallan con ENOSYS. Eso no es
+// un fallo del servicio sino una caracteristica del kernel, por lo que se
+// informa como informacion en lugar de como error.
+static void logBpfFailure(const char* func, int code) {
+    if (abs(code) == ENOSYS) {
+        ALOGI("%s failed: eBPF is not supported by this kernel (error code = %d)", func, code);
+    } else {
+        ALOGE("%s failed, error code = %d", func, code);
+    }
+}
+
 namespace android {
 
 static void native_init(JNIEnv* env, jobject clazz) {
   Status status = mTc.start();
    if (!isOk(status)) {
-    ALOGE("%s failed, error code = %d", __func__, status.code());
+    logBpfFailure(__func__, status.code());
   }
 }
 
