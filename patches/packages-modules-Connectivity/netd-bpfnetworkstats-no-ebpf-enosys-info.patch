From: MATYJAGUZ075 <matyjaguz075@users.noreply.github.com>
Date: Sun, 01 Nov 2026 00:00:00 +0000
Subject: [PATCH] Connectivity: degradar sin eBPF en lugar de fallar al leer
 las estadisticas de red

El kernel de este dispositivo (3.10) no soporta eBPF, asi que abrir los
mapas de estadisticas falla con ENOSYS. El codigo lo reportaba como error
y ademas hacia fallar toda la lectura, de modo que el servicio terminaba
registrando "problem reading network stats" una y otra vez.

Ahora, cuando el error es ENOSYS, se informa como informacion y la lectura
devuelve estadisticas vacias, dejando que el framework siga funcionando.
Para cualquier otro error se conserva el comportamiento original.

Este parche sustituye al anterior con el mismo nombre, que solo cambiaba
el nivel del log.

Note: el logging pasa por ALOGI/ALOGE para que el format string se
mantenga literal en el punto de llamada (el build usa
-Werror=format-security).

---
diff --git a/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp b/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp
index 9ebef4d6d2..c7350739fb 100644
--- a/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp
+++ b/service-t/native/libs/libnetworkstats/BpfNetworkStats.cpp
@@ -14,6 +14,7 @@
  * limitations under the License.
  */
 
+#include <errno.h>
 #include <inttypes.h>
 #include <net/if.h>
 #include <string.h>
@@ -44,6 +45,28 @@ using base::Result;
 // from the config value.
 static constexpr char const* STATS_MAP_PATH[] = {STATS_MAP_B_PATH, STATS_MAP_A_PATH};
 
+// Opening an eBPF map fails with ENOSYS when the kernel has no eBPF support
+// at all (bpf() arrived in Linux 4.x). The kernel of this device is 3.10, so
+// the network stats are simply not available: that is not an error
+// condition, and logging it as one floods the log with the very same
+// message over and over. Report it as informational instead, keeping the
+// error level for any other failure.
+#define LOG_MAP_OPEN_FAILURE(fmt, ...)                                                  \
+    do {                                                                                \
+        if (errno == ENOSYS) {                                                          \
+            ALOGI(fmt, ##__VA_ARGS__);                                                  \
+        } else {                                                                        \
+            ALOGE(fmt, ##__VA_ARGS__);                                                  \
+        }                                                                               \
+    } while (0)
+
+// El kernel de este dispositivo (3.10) no tiene eBPF, asi que abrir los mapas
+// falla con ENOSYS. En ese caso las estadisticas no existen: se devuelven
+// vacias en lugar de fallar, para que el framework siga funcionando.
+static bool isEbpfUnsupported(int err) {
+    return err == ENOSYS || err == -ENOSYS;
+}
+
 int bpfGetUidStatsInternal(uid_t uid, Stats* stats,
                            const BpfMap<uint32_t, StatsValue>& appUidStatsMap) {
     auto statsEntry = appUidStatsMap.readValue(uid);
@@ -62,7 +85,8 @@ int bpfGetUidStats(uid_t uid, Stats* stats) {
 
     if (!appUidStatsMap.isValid()) {
         int ret = -errno;
-        ALOGE("Opening appUidStatsMap(%s) failed: %s", APP_UID_STATS_MAP_PATH, strerror(errno));
+        LOG_MAP_OPEN_FAILURE("Opening appUidStatsMap(%s) failed: %s", APP_UID_STATS_MAP_PATH,
+                             strerror(errno));
         return ret;
     }
     return bpfGetUidStatsInternal(uid, stats, appUidStatsMap);
@@ -104,13 +128,13 @@ int bpfGetIfaceStats(const char* iface, Stats* stats) {
     int ret;
     if (!ifaceStatsMap.isValid()) {
         ret = -errno;
-        ALOGE("get ifaceStats map fd failed: %s", strerror(errno));
+        LOG_MAP_OPEN_FAILURE("get ifaceStats map fd failed: %s", strerror(errno));
         return ret;
     }
     BpfMapRO<uint32_t, IfaceValue> ifaceIndexNameMap(IFACE_INDEX_NAME_MAP_PATH);
     if (!ifaceIndexNameMap.isValid()) {
         ret = -errno;
-        ALOGE("get ifaceIndexName map fd failed: %s", strerror(errno));
+        LOG_MAP_OPEN_FAILURE("get ifaceIndexName map fd failed: %s", strerror(errno));
         return ret;
     }
     return bpfGetIfaceStatsInternal(iface, stats, ifaceStatsMap, ifaceIndexNameMap);
@@ -189,18 +213,32 @@ int parseBpfNetworkStatsDetail(std::vector<stats_line>* lines,
     BpfMapRO<uint32_t, IfaceValue> ifaceIndexNameMap(IFACE_INDEX_NAME_MAP_PATH);
     if (!ifaceIndexNameMap.isValid()) {
         int ret = -errno;
-        ALOGE("get ifaceIndexName map fd failed: %s", strerror(errno));
+        LOG_MAP_OPEN_FAILURE("get ifaceIndexName map fd failed: %s", strerror(errno));
+        if (isEbpfUnsupported(ret)) {
+            lines->clear();
+            return 0;
+        }
         return ret;
     }
 
     BpfMapRO<uint32_t, uint32_t> configurationMap(CONFIGURATION_MAP_PATH);
     if (!configurationMap.isValid()) {
         int ret = -errno;
-        ALOGE("get configuration map fd failed: %s", strerror(errno));
+        LOG_MAP_OPEN_FAILURE("get configuration map fd failed: %s", strerror(errno));
+        if (isEbpfUnsupported(ret)) {
+            lines->clear();
+            return 0;
+        }
         return ret;
     }
     auto configuration = configurationMap.readValue(CURRENT_STATS_MAP_CONFIGURATION_KEY);
     if (!configuration.ok()) {
+        int ret = -configuration.error().code();
+        if (isEbpfUnsupported(ret)) {
+            ALOGI("eBPF is not supported by this kernel, no network stats available");
+            lines->clear();
+            return 0;
+        }
         ALOGE("Cannot read the old configuration from map: %s",
               configuration.error().message().c_str());
         return -configuration.error().code();
@@ -209,7 +247,8 @@ int parseBpfNetworkStatsDetail(std::vector<stats_line>* lines,
     BpfMap<StatsKey, StatsValue> statsMap(statsMapPath);
     if (!statsMap.isValid()) {
         int ret = -errno;
-        ALOGE("get stats map fd failed: %s, path: %s", strerror(errno), statsMapPath);
+        LOG_MAP_OPEN_FAILURE("get stats map fd failed: %s, path: %s", strerror(errno),
+                             statsMapPath);
         return ret;
     }
 
@@ -266,14 +305,22 @@ int parseBpfNetworkStatsDev(std::vector<stats_line>* lines) {
     BpfMapRO<uint32_t, IfaceValue> ifaceIndexNameMap(IFACE_INDEX_NAME_MAP_PATH);
     if (!ifaceIndexNameMap.isValid()) {
         ret = -errno;
-        ALOGE("get ifaceIndexName map fd failed: %s", strerror(errno));
+        LOG_MAP_OPEN_FAILURE("get ifaceIndexName map fd failed: %s", strerror(errno));
+        if (isEbpfUnsupported(ret)) {
+            lines->clear();
+            return 0;
+        }
         return ret;
     }
 
     BpfMapRO<uint32_t, StatsValue> ifaceStatsMap(IFACE_STATS_MAP_PATH);
     if (!ifaceStatsMap.isValid()) {
         ret = -errno;
-        ALOGE("get ifaceStats map fd failed: %s", strerror(errno));
+        LOG_MAP_OPEN_FAILURE("get ifaceStats map fd failed: %s", strerror(errno));
+        if (isEbpfUnsupported(ret)) {
+            lines->clear();
+            return 0;
+        }
         return ret;
     }
     return parseBpfNetworkStatsDevInternal(lines, ifaceStatsMap, ifaceIndexNameMap);
