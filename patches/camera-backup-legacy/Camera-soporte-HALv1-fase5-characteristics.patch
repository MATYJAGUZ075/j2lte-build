+// Formatos de salida de la API2 (equivalentes a ImageFormat del framework).
+constexpr int32_t kLegacyFormatJpeg = 0x100;
+constexpr int32_t kLegacyFormatYuv420 = 0x23;
+constexpr int32_t kLegacyFormatPrivate = 0x101;
+
+// La API1 expresa los factores de zoom como una lista separada por ','.
+float getLegacyMaxZoom(const char *value) {
+    if (value == nullptr) return 1.0f;
+    float maxZoom = 1.0f;
+    const char *cursor = value;
+    while (*cursor != '\0') {
+        char *end = nullptr;
+        float ratio = strtof(cursor, &end);
+        if (end == cursor) break;
+        if (ratio > maxZoom) maxZoom = ratio;
+        cursor = end;
+        if (*cursor != ',') break;
+        ++cursor;
+    }
+    return maxZoom;
+}
+
+} // namespace
