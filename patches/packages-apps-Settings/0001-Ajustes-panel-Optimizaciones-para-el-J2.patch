+package com.android.settings.j2lte;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.core.PreferenceControllerMixin;
+
+/**
+ * Escala de animaciones del sistema (ventana, transiciones y animador).
+ *
+ * Con 0 las animaciones se desactivan: el J2 va mas fluido, aunque las
+ * transiciones se ven "a saltos".
+ */
+public class AnimationScaleController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener, PreferenceControllerMixin {
+
+    public AnimationScaleController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        if (!(preference instanceof ListPreference)) {
+            return;
+        }
+        final ListPreference listPreference = (ListPreference) preference;
+        final float scale = Settings.Global.getFloat(mContext.getContentResolver(),
+                Settings.Global.WINDOW_ANIMATION_SCALE, 1f);
+        final String value = String.valueOf(scale);
+        listPreference.setValue(value);
+        listPreference.setSummary(summaryFor(value));
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final float scale;
+        try {
+            scale = Float.parseFloat(String.valueOf(newValue));
+        } catch (NumberFormatException e) {
+            return false;
+        }
+        final ContentResolver resolver = mContext.getContentResolver();
+        Settings.Global.putFloat(resolver, Settings.Global.WINDOW_ANIMATION_SCALE, scale);
+        Settings.Global.putFloat(resolver, Settings.Global.TRANSITION_ANIMATION_SCALE, scale);
+        Settings.Global.putFloat(resolver, Settings.Global.ANIMATOR_DURATION_SCALE, scale);
+        return true;
+    }
+
+    /** Resumen con el nombre de la opcion seleccionada. */
+    private CharSequence summaryFor(String value) {
+        final String[] values = mContext.getResources().getStringArray(
+                R.array.j2lte_animation_scale_values);
+        final String[] entries = mContext.getResources().getStringArray(
+                R.array.j2lte_animation_scale_entries);
+        for (int i = 0; i < values.length && i < entries.length; i++) {
+            if (values[i].equals(value)) {
+                return entries[i];
+            }
+        }
+        return value;
+    }
+}
