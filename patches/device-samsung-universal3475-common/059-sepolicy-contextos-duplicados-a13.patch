diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -92,7 +92,6 @@
 /data/nfc(/.*)?              u:object_r:nfc_data_file:s0
 /data/\.cid\.info                  u:object_r:wifi_data_file:s0
 /data/misc/conn/\.wifiver\.info    u:object_r:wifi_data_file:s0
-/data/misc/radio(/.*)?       u:object_r:radio_data_file:s0
 /data/vendor/display(/.*)?   u:object_r:display_vendor_data_file:s0
 
 # gps
diff --git a/sepolicy/vendor/file_contexts_cpefs b/sepolicy/vendor/file_contexts_cpefs
--- a/sepolicy/vendor/file_contexts_cpefs
+++ b/sepolicy/vendor/file_contexts_cpefs
@@ -1 +1,9 @@
-/cpefs(/.*)?                 u:object_r:system_file:s0
+# /cpefs se etiqueta en sepolicy/vendor/file_contexts como sec_efs_file.
+#
+# Este fichero existia en el fork con la etiqueta system_file, que en A13
+# provocaba un conflicto en checkfc:
+#   Multiple different specifications for /cpefs(/.*)?
+#     (u:object_r:sec_efs_file:s0 and u:object_r:system_file:s0)
+# El montaje de /cpefs lo hace init y rild/audioserver necesitan leerlo como
+# sec_efs_file (ver init.te y rild.te), asi que la etiqueta correcta es la de
+# file_contexts y aqui no debe declararse /cpefs otra vez.
diff --git a/sepolicy/vendor/rild.te b/sepolicy/vendor/rild.te
--- a/sepolicy/vendor/rild.te
+++ b/sepolicy/vendor/rild.te
@@ -35,8 +35,13 @@ allow rild proc_qtaguid_stat:file r_file_perms;
 r_dir_file(rild, mediaserver);
 
 # /data/misc/radio/*
+# En A13 AOSP etiqueta /data/misc/radio como radio_core_data_file (en Q era
+# radio_data_file); se conservan ambas reglas para no romper si algun dia
+# vuelve la etiqueta antigua.
 allow rild radio_data_file:dir rw_dir_perms;
 allow rild radio_data_file:file create_file_perms;
+allow rild radio_core_data_file:dir rw_dir_perms;
+allow rild radio_core_data_file:file create_file_perms;
 # /data/data/com.android.providers.telephony/databases/telephony.db
 allow rild radio_data_file:lnk_file r_file_perms;
 
